{
  "firestore": {
    "rules": "firestore.rules"
  },
  "react-native": {
    "analytics_auto_collection_enabled": false,
    "analytics_default_allow_ad_personalization_signals": false,
    "analytics_default_allow_ad_storage": false,
    "analytics_default_allow_ad_user_data": false,
    "analytics_default_allow_analytics_storage": false,
    "crashlytics_auto_collection_enabled": false,
    "crashlytics_is_error_generation_on_js_crash_enabled": true,
    "crashlytics_javascript_exception_handler_chaining_enabled": false,
    "google_analytics_adid_collection_enabled": false,
    "google_analytics_automatic_screen_reporting_enabled": false,
    "google_analytics_ssaid_collection_enabled": false,
    "perf_auto_collection_enabled": false
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix functions run lint"
      ]
    }
  ]
}
